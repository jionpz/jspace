
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Editor and tool caches
.idea/
.vscode/
.cache/
.eslintcache
.workbuddy/

# Harness / platform config (Trellis-managed, regenerable)
.pi/
.omp/
.codex/
.claude/
.agents/
.opencode/
.cursor/

# But the workbench template ships a SessionStart hook for jspace cron check —
# that file is a real template asset and must be committed.
!templates/workbench/.claude/
!templates/workbench/.claude/settings.json

# Trellis local scaffolding (regenerated by `trellis init`; not versioned)
.trellis/spec/
.trellis/tasks/
.trellis/workspace/

# Temporary files
tmp/
temp/
*.tmp

# Python
__pycache__/
*.pyc

# Bun / Node
node_modules/
*.bun-build

# Compiled JSpace binaries (built via `bun build --compile`; not committed)
bin/jspace
bin/jspace-*.exe
bin/jspace-*
