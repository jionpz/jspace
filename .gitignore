
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Editor and tool caches
.idea/
.vscode/
.cache/
