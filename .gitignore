
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Editor and tool caches
.idea/
.vscode/
.cache/
.eslintcache
.workbuddy/
.mindfs/

# Harness / platform config (Trellis-managed, regenerable)
.pi/
.omp/
.omc/
.omo/
.codex/
.claude/
.agents/
.opencode/
.grok/
.cursor/

# But the workbench template ships real assets under harness config dirs —
# these are seed templates (hooks / plugins) and must be committed, not ignored
# like the regenerable machine-level config above. A dropped exception here
# silently loses the template file from git while the generated bundle keeps its
# bytes (issue #6: the .opencode plugin was lost this way). Add a
# `!templates/workbench/.<harness>/` + `/**` pair when a new harness seed ships.
!templates/workbench/.claude/
!templates/workbench/.claude/**
!templates/workbench/.opencode/
!templates/workbench/.opencode/**
!templates/workbench/.grok/
!templates/workbench/.grok/**
!templates/workbench/.cursor/
!templates/workbench/.cursor/**

# Trellis — only spec/ is versioned. tasks/ (incl. archives) and workspace/
# (session journals) stay local-only: they contain real personal paths and the
# repo is public. Local-only runtime state (backups, .runtime, caches) is
# excluded via the nested .trellis/.gitignore.
.trellis/tasks/
.trellis/workspace/

# Temporary files
tmp/
temp/
*.tmp

# Python
__pycache__/
*.pyc

# Bun / Node
node_modules/
*.bun-build

# Compiled JSpace binaries (built via `bun build --compile`; not committed)
bin/jspace
bin/jspace-*.exe
bin/jspace-*
